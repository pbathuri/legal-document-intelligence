# --- LLM: default local Ollama agents (OpenAI-compatible /v1) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY
LLM_MODEL=llama3.2

# For vLLM / MI300X instead:
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=meta-llama/Llama-3.1-70B-Instruct

# Optional multimodel routing (empty = use LLM_MODEL for all tasks)
# LLM_MODEL_EXTRACTION=
# LLM_MODEL_SPECIALIST=
# LLM_MODEL_SYNTHESIS=

# --- Mock mode (set to 0 for real LLM) ---
LEGAL_INTEL_MOCK_LLM=1

# --- Embeddings: Ollama /api/embed (default) or sentence-transformers ---
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=BAAI/bge-m3

# --- Local filesystem ingest (comma-separated absolute directory prefixes; empty = disabled) ---
# LEGAL_INTEL_ALLOW_LOCAL_PATHS=/Users/you/Documents/legal-pdfs,/tmp/legal_intel_pdfs

# --- Domain ---
DILIGENCE_DOMAIN=india_re

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
# QDRANT_URL=:memory:

# --- FastAPI CORS (comma-separated origins; * for dev) ---
# LEGAL_INTEL_CORS_ORIGINS=*

# --- Local persistence (device) ---
# PERSIST_UPLOADS=1
# UPLOAD_STORAGE_DIR=data/uploads
# PERSIST_RUNS=1
# RUNS_DB_PATH=data/local/runs.db
# OLLAMA_PROBE_TIMEOUT_SECONDS=2

# --- OCR ---
OCR_ENABLED=true
OCR_LANG=eng+hin+kan+tam+tel+mar

# --- Scraper ---
SCRAPER_DATA_DIR=data/raw
SCRAPER_RATE_LIMIT=2.0

# Indian Kanoon — token from https://api.indiankanoon.org/ (do not commit real value)
# INDIAN_KANOON_API_TOKEN=
