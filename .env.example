# --- LLM (vLLM on AMD MI300X, or Ollama OpenAI-compatible /v1) ---
LLM_PROVIDER=openai_compatible
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1

OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY
LLM_MODEL=meta-llama/Llama-3.1-70B-Instruct

# Optional multimodel routing (empty = use LLM_MODEL for all tasks)
# LLM_MODEL_EXTRACTION=
# LLM_MODEL_SPECIALIST=
# LLM_MODEL_SYNTHESIS=

# --- Mock mode (set to 0 for real LLM) ---
LEGAL_INTEL_MOCK_LLM=1

# --- Domain ---
DILIGENCE_DOMAIN=india_re

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
# QDRANT_URL=:memory:

# --- FastAPI CORS (comma-separated origins; * for dev) ---
# LEGAL_INTEL_CORS_ORIGINS=*

# --- OCR ---
OCR_ENABLED=true
OCR_LANG=eng+hin+kan+tam+tel+mar

# --- Scraper ---
SCRAPER_DATA_DIR=data/raw
SCRAPER_RATE_LIMIT=2.0

# Indian Kanoon — token from https://api.indiankanoon.org/ (do not commit real value)
# INDIAN_KANOON_API_TOKEN=
